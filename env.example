import { useEffect, useRef, useState } from 'react';
import api from '../api/axios';
import { loadFaceModels, getFaceDescriptor } from '../utils/faceapi';
import StatusBadge from '../components/StatusBadge';

export default function MarkAttendance() {
  const videoRef = useRef(null);
  const [modelsReady, setModelsReady] = useState(false);
  const [scanning, setScanning] = useState(false);
  const [error, setError] = useState('');
  const [result, setResult] = useState(null); // { status, faceMatched, withinGeofence, ... }

  useEffect(() => {
    let stream;
    (async () => {
      await loadFaceModels();
      setModelsReady(true);
      stream = await navigator.mediaDevices.getUserMedia({ video: {} });
      if (videoRef.current) videoRef.current.srcObject = stream;
    })().catch(() => setError('Camera access is required to mark attendance'));

    return () => stream?.getTracks().forEach((t) => t.stop());
  }, []);

  const getLocation = () =>
    new Promise((resolve, reject) => {
      if (!navigator.geolocation) {
        reject(new Error('Geolocation is not supported on this device'));
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
        (err) => reject(err),
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

  const handleScan = async () => {
    setError('');
    setResult(null);
    setScanning(true);

    try {
      const [faceDescriptor, location] = await Promise.all([
        getFaceDescriptor(videoRef.current),
        getLocation(),
      ]);

      if (!faceDescriptor) {
        setError('No face detected — center your face in the frame and try again');
        setScanning(false);
        return;
      }

      const { data } = await api.post('/attendance/mark', {
        faceDescriptor,
        lat: location.lat,
        lng: location.lng,
      });

      setResult(data.record);
    } catch (err) {
      setError(err.response?.data?.message || err.message || 'Could not verify attendance');
    } finally {
      setScanning(false);
    }
  };

  return (
    <div className="container" style={{ display: 'flex', justifyContent: 'center', marginTop: 56 }}>
      <div className="card" style={{ width: 420 }}>
        <p className="eyebrow">Live verification</p>
        <h2 style={{ fontFamily: 'var(--font-display)', marginTop: 4, marginBottom: 20 }}>
          Mark today's attendance
        </h2>

        <div
          style={{
            position: 'relative',
            width: '100%',
            aspectRatio: '4/3',
            background: '#000',
            borderRadius: 8,
            overflow: 'hidden',
            marginBottom: 16,
          }}
        >
          <video
            ref={videoRef}
            autoPlay
            muted
            playsInline
            style={{ width: '100%', height: '100%', objectFit: 'cover', transform: 'scaleX(-1)' }}
          />

          {['top:10px;left:10px;border-right:none;border-bottom:none',
            'top:10px;right:10px;border-left:none;border-bottom:none',
            'bottom:10px;left:10px;border-right:none;border-top:none',
            'bottom:10px;right:10px;border-left:none;border-top:none']
            .map((pos, i) => (
              <span
                key={i}
                style={{
                  position: 'absolute',
                  width: 22,
                  height: 22,
                  border: `2px solid ${
                    result?.status === 'present'
                      ? 'var(--accent-verified)'
                      : result?.status === 'flagged'
                      ? 'var(--accent-flagged)'
                      : 'var(--accent-pending)'
                  }`,
                  ...Object.fromEntries(pos.split(';').map((p) => p.split(':'))),
                }}
              />
          ))}

          {scanning && (
            <div
              style={{
                position: 'absolute',
                left: 0,
                right: 0,
                height: 2,
                background: 'var(--accent-pending)',
                animation: 'scanline 1.2s linear infinite',
                boxShadow: '0 0 12px var(--accent-pending)',
              }}
            />
          )}
          <style>{`@keyframes scanline { 0% { top: 0%; } 100% { top: 100%; } }`}</style>
        </div>

        <button
          className="btn btn-primary"
          onClick={handleScan}
          disabled={!modelsReady || scanning}
          style={{ width: '100%', marginBottom: 16 }}
        >
          {scanning ? 'Verifying…' : 'Scan & mark attendance'}
        </button>

        {error && <p style={{ color: 'var(--accent-flagged)', fontSize: 13 }}>{error}</p>}

        {result && (
          <div style={{ borderTop: '1px solid var(--border)', paddingTop: 16, fontSize: 13 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
              <span style={{ color: 'var(--text-muted)' }}>Result</span>
              <StatusBadge status={result.status} />
            </div>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
              <span style={{ color: 'var(--text-muted)' }}>Face match distance</span>
              <span className="eyebrow">{result.faceMatchDistance}</span>
            </div>
            <div style={{ display: 'flex', justifyContent: 'space-between' }}>
              <span style={{ color: 'var(--text-muted)' }}>Distance from campus</span>
              <span className="eyebrow">{result.distanceFromCampusMeters} m</span>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
